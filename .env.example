# OpenAI-compatible Qwen endpoint
OPENAI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=qwen3.8-flash

# Optional Alibaba Cloud OSS configuration
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-with-your-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret
OSS_BUCKET=replace-with-your-bucket
